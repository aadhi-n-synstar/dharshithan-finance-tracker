# ======================================================================
# Dharshithan Waterproofing - Multi-Cloud Database Environment Config
# Free Tier Supported: Supabase (Recommended), MongoDB Atlas, or Neon
# ======================================================================

# Active Provider: 'supabase', 'mongodb', or 'neon' (defaults to 'supabase')
DB_PROVIDER="supabase"

# 1. Supabase Cloud Database (100% Free Forever Tier)
# Obtain from https://supabase.com/dashboard/project/_/settings/database
SUPABASE_DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 2. MongoDB Atlas (Free M0 Sandbox - 512MB)
# Obtain from https://cloud.mongodb.com/ (Connect > Drivers)
MONGODB_URI="mongodb+srv://[USERNAME]:[PASSWORD]@cluster0.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME="dharshithan_finance"

# 3. Neon Cloud Database (PostgreSQL)
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-late-art-b5308bnc-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:YOUR_PASSWORD@ep-late-art-b5308bnc.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require"
NEON_BRANCH="production"
NEON_AUTH_BASE_URL="https://ep-late-art-b5308bnc.neonauth.c-7.us-east-2.aws.neon.tech/neondb/auth"
NEON_AUTH_JWKS_URL="https://ep-late-art-b5308bnc.neonauth.c-7.us-east-2.aws.neon.tech/neondb/auth/.well-known/jwks.json"
NEON_REALTIME_URL="wss://ep-late-art-b5308bnc.rt.c-7.us-east-2.aws.neon.tech/"
NEON_REALTIME_SECRET="YOUR_REALTIME_SECRET"
